# VoidCode environment example
#
# Copy this file to `.env` (gitignored) and fill in only the keys you need.
# All variables are optional; runtime defaults apply when a variable is unset.

# ─── Runtime configuration ───────────────────────────────────────────────────
# Provider-backed runs require an explicit model and provider credentials.

# Provider example (use together with OPENAI_API_KEY below):
# VOIDCODE_MODEL=openai/gpt-4o-mini

# Default model used when --model is not provided on the CLI.
# Format: "<provider>/<model>" (for example: openai/gpt-4o-mini).
VOIDCODE_MODEL=

# Approval mode for write/edit/shell tools: ask | write | yolo
VOIDCODE_APPROVAL_MODE=


# Per-tool timeout in seconds.
VOIDCODE_TOOL_TIMEOUT_SECONDS=

# Reasoning effort hint forwarded to providers that support it: low | medium | high
VOIDCODE_REASONING_EFFORT=

# Override the persistent session SQLite path.
# Default: $XDG_STATE_HOME/voidcode/sessions.sqlite3
VOIDCODE_DB_PATH=

# ─── Provider credentials ────────────────────────────────────────────────────
# Provide whichever providers you intend to use; leave the rest unset.

# Optional provider credentials (choose one provider; OpenAI matches README example)
OPENCODE_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# GitHub Copilot
GITHUB_COPILOT_TOKEN=

# OpenAI-compatible endpoint: configuration-driven base URL + credentials
ENDPOINT_API_KEY=
# Request base URL, e.g. http://127.0.0.1:4000/v1; model discovery derives from it.
ENDPOINT_BASE_URL=

# Z.AI international
ZAI_API_KEY=

# ZhipuAI domestic (falls back to ZAI_API_KEY when unset)
ZHIPU_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Moonshot (falls back to KIMI_API_KEY when unset)
MOONSHOT_API_KEY=

# Moonshot fallback key (legacy Kimi spelling)
KIMI_API_KEY=

# MiniMax (OpenAI-wire)
MINIMAX_API_KEY=

# MiniMax CN (Anthropic-wire)
MINIMAX_CN_API_KEY=

# Aliyun Dashscope
DASHSCOPE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq
GROQ_API_KEY=

# Together
TOGETHER_API_KEY=

# Fireworks AI
FIREWORKS_API_KEY=

# Mistral
MISTRAL_API_KEY=

# ─── Search / capability credentials ─────────────────────────────────────────
# Built-in web_search tries these backends in fixed order and uses the first
# one with a credential set. Jina answers keyless at low volume as the last
# resort; a JINA_API_KEY raises its rate limit.
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
TINYFISH_API_KEY=
JINA_API_KEY=
KAGI_API_KEY=
FIRECRAWL_API_KEY=
# Self-hosted Firecrawl base URL (enables the firecrawl backend without an API key).
FIRECRAWL_BASE_URL=
# Self-hosted SearXNG instance base URL; optional auth for private instances.
SEARXNG_ENDPOINT=
SEARXNG_TOKEN=
