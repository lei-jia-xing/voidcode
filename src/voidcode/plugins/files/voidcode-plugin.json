{
  "plugin_id": "files",
  "version": "1.0.0",
  "sdk_protocol": 1,
  "schema_version": 1,
  "entrypoint": "files_plugin:create_plugin",
  "files": [
    {
      "path": "__init__.py",
      "sha256": "770ec83c5811805f3bcea4530be8f6753812c4678a32f5c20574546e183dcc80"
    },
    {
      "path": "files_plugin.py",
      "sha256": "7cc4ba204d5c9ebe0340e9d11071572b02dc7eebdfbe4d01e2dcce33f564aa26"
    }
  ],
  "tools": [
    {
      "name": "read",
      "description": "Read a UTF-8 text file from the current workspace.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the workspace."
          },
          "offset": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "1-based line offset."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1000,
            "description": "Maximum number of lines to read."
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "effects": [
        "read"
      ],
      "replay_policy": "safe",
      "capabilities": [
        "workspace.read"
      ]
    },
    {
      "name": "write",
      "description": "Write a UTF-8 text file inside the current workspace.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the workspace."
          },
          "content": {
            "type": "string",
            "maxLength": 65536,
            "description": "Complete UTF-8 file contents (max 64 KiB)."
          },
          "expectedHash": {
            "type": "string",
            "description": "Required when target file exists: SHA-256 hash of current file content."
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "effects": [
        "write"
      ],
      "replay_policy": "never",
      "capabilities": [
        "workspace.write"
      ]
    }
  ],
  "commands": [],
  "capabilities": [
    {
      "name": "workspace.read",
      "reason": "Read workspace files"
    },
    {
      "name": "workspace.write",
      "reason": "Write workspace files"
    }
  ],
  "providers": [],
  "depends": [],
  "state_schema_version": 1,
  "config_schema": {
    "type": "object"
  }
}
