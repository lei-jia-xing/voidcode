  "tools": [],
  "commands": [
    {
      "name": "review",
      "description": "Review current workspace changes with the governed review agent.",
      "argument_schema": {
        "type": "object",
        "properties": {
          "focus": {
            "type": "string",
            "description": "Optional reviewer focus; a focus alone reviews it as a custom target."
          },
          "target": {
            "type": "string",
            "description": "Optional target type: uncommitted (default), base_branch, commit, or custom. The legacy aliases uncommittedChanges and baseBranch are accepted too."
          },
          "branch": {
            "type": "string",
            "description": "Base branch name, required by target=base_branch."
          },
          "sha": {
            "type": "string",
            "description": "Commit sha, required by target=commit."
          }
        },
        "additionalProperties": false
      },
      "effects": [
        "read",
        "spawn"
      ],
      "capabilities": [
        "workspace.read"
      ],
      "busy_gate": true,
      "client_capabilities": [],
      "direct_user": false
    }
  ],
  "capabilities": [
    {
      "name": "workspace.read",
      "reason": "Read workspace git state and diffs for review targets."
    }
  ],
