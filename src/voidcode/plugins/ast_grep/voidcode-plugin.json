  "tools": [
    {
      "name": "ast_grep",
      "description": "Structural code search and rewrite with ast-grep. Search and preview are read operations; replace mutates files and requires approval.",
      "input_schema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "search",
              "preview",
              "replace"
            ],
            "description": "AST operation to perform."
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "description": "ast-grep pattern."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Workspace-relative or absolute file or directory path."
          },
          "rewrite": {
            "type": "string"
          },
          "lang": {
            "type": "string"
          },
          "apply": {
            "type": "boolean"
          },
          "expectedHash": {
            "type": "string",
            "description": "Optional expected SHA-256 content hash of target file for replace mode."
          }
        },
        "required": [
          "mode",
          "pattern",
          "path"
        ],
        "additionalProperties": false
      },
      "effects": [
        "write"
      ],
      "replay_policy": "never",
      "capabilities": [
        "workspace.read",
        "workspace.write"
      ]
    }
  ],
  "commands": [],
  "capabilities": [
    {
      "name": "workspace.read",
      "reason": "Search workspace files structurally"
    },
    {
      "name": "workspace.write",
      "reason": "Rewrite matched workspace files in place"
    }
  ],
  "providers": [],
  "depends": [],
  "state_schema_version": 1,
  "config_schema": {
    "type": "object"
  }
