  "tools": [
    {
      "name": "cron_create",
      "description": "Schedule a prompt to run at a future time — either recurring on an interval or cron schedule, or once at a specific time. Max 50 schedules per session. Returns the schedule ID and human-readable cadence.",
      "input_schema": {
        "type": "object",
        "properties": {
          "schedule": {
            "type": "string",
            "description": "Schedule expression: 'every <N><s|m|h|d>' (e.g. 'every 10m'), 'at <ISO-8601>' (e.g. 'at 2026-10-18T10:00:00'), 'cron <min> <hour> <day> <month> <dow>' (e.g. 'cron */5 * * * *'), or 'once'."
          },
          "prompt": {
            "type": "string",
            "description": "The prompt to enqueue and execute on each fire."
          }
        },
        "required": [
          "schedule",
          "prompt"
        ],
        "additionalProperties": false
      },
      "effects": [
        "session"
      ],
      "replay_policy": "never",
      "capabilities": [],
      "supports_parallel": false,
      "path_argument_keys": []
    },
    {
      "name": "cron_delete",
      "description": "Cancel a scheduled cron job by ID.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Schedule/job ID to cancel."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "effects": [
        "session"
      ],
      "replay_policy": "never",
      "capabilities": [],
      "supports_parallel": false,
      "path_argument_keys": []
    },
    {
