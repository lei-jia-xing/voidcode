  "tools": [
    {
      "name": "web_fetch",
      "description": "Fetch one URL as text, markdown, or HTML. When a textual result is truncated it returns content_ref and next_byte_offset; call again with exactly those two fields to read the next page from this session's artifact store, without fetching the network again.",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Initial call: the URL to fetch content from"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "markdown",
              "html"
            ],
            "description": "Initial call: output format (default: markdown)"
          },
          "timeout": {
            "type": "integer",
            "description": "Initial call: timeout in seconds (max 120)"
          },
          "content_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Continuation call: the content_ref from a truncated web_fetch result"
          },
          "byte_offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Continuation call: the next_byte_offset from the previous page"
          }
        },
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "text",
                  "markdown",
                  "html"
                ]
              },
              "timeout": {
                "type": "integer"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "content_ref": {
                "type": "string",
                "minLength": 1
              },
              "byte_offset": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "content_ref",
              "byte_offset"
            ],
            "additionalProperties": false
          }
        ],
        "additionalProperties": false
      },
      "effects": [
        "read",
        "network"
      ],
      "capabilities": [
        "network"
      ]
    },
    {
      "name": "web_search",
      "description": "Search the web for information. Returns search results with titles, URLs, and snippets.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query"
          },
          "numResults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Number of results to return (default: 8)"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "effects": [
        "read",
        "network"
      ],
      "capabilities": [
        "network"
      ]
    }
  ],
  "commands": [],
  "providers": [],
  "capabilities": [
    {
      "name": "network",
      "reason": "Fetch URLs and query web search provider endpoints over the network"
    }
  ],
  "depends": [],
  "state_schema_version": 1,
  "config_schema": {
    "type": "object"
  }
}
