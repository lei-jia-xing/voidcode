      ],
      "capabilities": [
        "workspace.read"
      ],
      "busy_gate": false,
      "client_capabilities": []
    }
  ],
  "capabilities": [
    {
      "name": "workspace.read",
      "reason": "Discover and read workspace SKILL.md files."
    }
  ],
